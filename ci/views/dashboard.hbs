<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Console | Deployer Platform</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0" />
    
    <style>
        :root {
            /* Palette (Mesma do Login) */
            --bg-color: #0f172a;
            --surface-color: #1e293b;
            --surface-light: #334155;
            --primary-color: #38bdf8; /* Sky */
            --accent-color: #22d3ee;  /* Cyan */
            --danger: #ef4444;
            --warning: #f59e0b;
            --success: #22c55e;
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --border-color: rgba(255,255,255,0.08);
            
            /* Layout */
            --sidebar-width: 260px;
            --header-height: 70px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background-color: var(--bg-color);
            color: var(--text-primary);
            font-family: 'Segoe UI', system-ui, sans-serif;
            height: 100vh;
            display: grid;
            grid-template-columns: var(--sidebar-width) 1fr;
            grid-template-rows: var(--header-height) 1fr;
            grid-template-areas: 
                "sidebar header"
                "sidebar main";
            overflow: hidden;
        }

        /* --- SIDEBAR --- */
        .sidebar {
            grid-area: sidebar;
            background: rgba(15, 23, 42, 0.95);
            border-right: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            padding: 24px;
            z-index: 20;
        }

        .brand {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--text-primary);
            margin-bottom: 40px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .brand span { color: var(--primary-color); }
        .brand-icon { 
            width: 32px; height: 32px; 
            background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
            border-radius: 8px;
            display: grid; place-items: center; color: #0f172a; font-size: 1.2rem;
        }

        .nav-menu { list-style: none; display: flex; flex-direction: column; gap: 8px; }
        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            border-radius: 8px;
            color: var(--text-secondary);
            text-decoration: none;
            transition: all 0.2s;
            font-weight: 500;
        }
        .nav-item:hover, .nav-item.active {
            background: rgba(56, 189, 248, 0.1);
            color: var(--primary-color);
        }
        .nav-item .material-symbols-rounded { font-size: 20px; }

        .sidebar-footer { margin-top: auto; padding-top: 20px; border-top: 1px solid var(--border-color); }
        .user-mini { display: flex; align-items: center; gap: 12px; }
        .avatar { width: 40px; height: 40px; border-radius: 50%; background: var(--surface-light); display: grid; place-items: center; font-weight: bold; color: var(--primary-color); border: 2px solid var(--bg-color); outline: 2px solid var(--primary-color); }

        /* --- HEADER --- */
        .header {
            grid-area: header;
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 32px;
            z-index: 10;
        }

        .breadcrumbs { color: var(--text-secondary); font-size: 0.9rem; }
        .breadcrumbs span { color: var(--text-primary); font-weight: 600; margin-left: 5px; }

        .global-status { display: flex; gap: 24px; align-items: center; }
        .status-pill {
            display: flex; align-items: center; gap: 8px;
            font-size: 0.85rem;
            color: var(--text-secondary);
            background: rgba(255,255,255,0.03);
            padding: 6px 12px;
            border-radius: 20px;
            border: 1px solid var(--border-color);
        }
        .status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--success); box-shadow: 0 0 8px var(--success); animation: pulse 2s infinite; }
        
        @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.5; } 100% { opacity: 1; } }

        /* --- MAIN CONTENT --- */
        .main {
            grid-area: main;
            padding: 32px;
            overflow-y: auto;
            /* Background Grid técnico */
            background-image: linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px), 
            linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
            background-size: 40px 40px;
        }

        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            grid-template-rows: auto auto 1fr;
            gap: 24px;
            max-width: 1600px;
            margin: 0 auto;
        }

        /* Widgets Genéricos */
        .widget {
            background: rgba(30, 41, 59, 0.6);
            backdrop-filter: blur(12px);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 24px;
            display: flex;
            flex-direction: column;
            position: relative;
            overflow: hidden;
            transition: transform 0.2s, border-color 0.2s;
        }
        .widget:hover { border-color: rgba(56, 189, 248, 0.3); }

        .widget-title { font-size: 0.9rem; color: var(--text-secondary); font-weight: 600; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center; }

        /* KPI Cards (Topo) */
        .kpi-card { grid-column: span 1; }
        .kpi-value { font-size: 2.5rem; font-weight: 700; color: var(--text-primary); margin-bottom: 4px; }
        .kpi-sub { font-size: 0.85rem; color: var(--success); display: flex; align-items: center; gap: 4px; }
        
        /* Topology Visualizer (O Destaque) */
        .topology-widget {
            grid-column: span 3;
            grid-row: span 2;
            min-height: 400px;
            background: radial-gradient(circle at center, rgba(56, 189, 248, 0.05) 0%, transparent 70%), rgba(30, 41, 59, 0.6);
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Simulação Visual do CORE */
        .vis-container { position: relative; width: 100%; height: 100%; }
        
        .node-core {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
            width: 80px; height: 80px;
            background: var(--bg-color);
            border: 2px solid var(--primary-color);
            border-radius: 50%;
            display: grid; place-items: center;
            box-shadow: 0 0 30px rgba(56, 189, 248, 0.2);
            z-index: 5;
            font-weight: bold; font-size: 0.8rem; color: var(--primary-color);
        }

        .node-module {
            position: absolute;
            width: 50px; height: 50px;
            background: var(--surface-color);
            border: 1px solid var(--text-secondary);
            border-radius: 12px;
            display: grid; place-items: center;
            font-size: 1.2rem;
            z-index: 5;
            transition: all 0.3s;
        }
        /* Posicionamento orbital manual para demo */
        .nm-1 { top: 20%; left: 20%; border-color: var(--success); color: var(--success); }
        .nm-2 { top: 20%; right: 20%; border-color: var(--success); color: var(--success); }
        .nm-3 { bottom: 20%; left: 30%; border-color: var(--warning); color: var(--warning); }
        .nm-4 { bottom: 30%; right: 15%; border-color: var(--success); color: var(--success); }

        /* Linhas de conexão (SVG) */
        .connections { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; }
        .connection-line { stroke: var(--text-secondary); stroke-width: 1; stroke-dasharray: 5; opacity: 0.3; animation: flow 20s linear infinite; }
        @keyframes flow { to { stroke-dashoffset: -100; } }

        /* Lista de Módulos */
        .modules-list-widget { grid-column: span 1; grid-row: span 2; display: flex; flex-direction: column; }
        .module-item {
            display: flex; align-items: center; justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid var(--border-color);
        }
        .module-item:last-child { border: none; }
        .mi-info h4 { font-size: 0.9rem; margin-bottom: 2px; }
        .mi-info p { font-size: 0.75rem; color: var(--text-secondary); }
        .mi-status { width: 10px; height: 10px; border-radius: 50%; }
        .st-active { background: var(--success); box-shadow: 0 0 5px var(--success); }
        .st-warning { background: var(--warning); box-shadow: 0 0 5px var(--warning); }
        .st-inactive { background: var(--surface-light); }

        /* Terminal Logs */
        .terminal-widget {
            grid-column: span 4;
            height: 250px;
            background: #000;
            font-family: 'Courier New', monospace;
            padding: 0; /* Header separado do corpo */
            border: 1px solid #333;
        }
        .term-header {
            background: #111; padding: 8px 16px; border-bottom: 1px solid #333;
            display: flex; justify-content: space-between; align-items: center;
        }
        .term-body { padding: 16px; overflow-y: auto; height: calc(100% - 40px); font-size: 0.85rem; }
        .log-entry { margin-bottom: 4px; display: flex; gap: 12px; }
        .log-ts { color: var(--text-secondary); opacity: 0.5; }
        .log-info { color: var(--primary-color); }
        .log-warn { color: var(--warning); }
        .log-msg { color: #eee; }

        /* Botões de Ação Rápida */
        .action-btn {
            padding: 6px 12px;
            border-radius: 6px;
            border: 1px solid var(--border-color);
            background: transparent;
            color: var(--text-secondary);
            cursor: pointer;
            font-size: 0.8rem;
            transition: all 0.2s;
        }
        .action-btn:hover { background: var(--primary-color); color: #000; border-color: var(--primary-color); }

    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="brand">
            <div class="brand-icon">D</div>
            apps<span>.deployer</span>
        </div>
        
        <ul class="nav-menu">
            <li><a href="#" class="nav-item active"><span class="material-symbols-rounded">dashboard</span> Visão Geral</a></li>
            <li><a href="#" class="nav-item"><span class="material-symbols-rounded">extension</span> Módulos</a></li>
            <li><a href="#" class="nav-item"><span class="material-symbols-rounded">hub</span> Topologia</a></li>
            <li><a href="#" class="nav-item"><span class="material-symbols-rounded">terminal</span> Logs & Trace</a></li>
            <li><a href="#" class="nav-item"><span class="material-symbols-rounded">settings</span> Configurações</a></li>
        </ul>

        <div class="sidebar-footer">
            <div class="user-mini">
                <div class="avatar">{{ user.avatar }}</div>
                <div>
                    <div style="font-size: 0.9rem; font-weight: 600;">{{ user.name }}</div>
                    <div style="font-size: 0.75rem; color: var(--text-secondary);">Admin Workspace</div>
                </div>
            </div>
        </div>
    </aside>

    <header class="header">
        <div class="breadcrumbs">
            Console / <span>Overview</span>
        </div>

        <div class="global-status">
            <div class="status-pill">
                <div class="status-dot"></div>
                Apps Core Online
            </div>
            <div class="status-pill">
                <span class="material-symbols-rounded" style="font-size: 16px;">dns</span>
                {{ systemStatus.latency }}
            </div>
            <button class="action-btn" style="border-color: var(--primary-color); color: var(--primary-color);">+ Acoplar Módulo</button>
        </div>
    </header>

    <main class="main">
        <div class="dashboard-grid">
            
            <div class="widget kpi-card">
                <div class="widget-title">Módulos Ativos <span class="material-symbols-rounded">extension</span></div>
                <div class="kpi-value">{{ systemStatus.activeModules }}</div>
                <div class="kpi-sub">Total registrado: 12</div>
            </div>
            <div class="widget kpi-card">
                <div class="widget-title">Uptime (7d) <span class="material-symbols-rounded">timelapse</span></div>
                <div class="kpi-value">{{ systemStatus.uptime }}</div>
                <div class="kpi-sub">Sem incidentes críticos</div>
            </div>
            <div class="widget kpi-card">
                <div class="widget-title">Memória Heap <span class="material-symbols-rounded">memory</span></div>
                <div class="kpi-value">{{ systemStatus.totalMemory }}</div>
                <div class="kpi-sub" style="color: var(--warning);">Pico detectado às 14:00</div>
            </div>
            <div class="widget kpi-card">
                <div class="widget-title">Request/Sec <span class="material-symbols-rounded">bolt</span></div>
                <div class="kpi-value">4.2k</div>
                <div class="kpi-sub">+12% vs hora anterior</div>
            </div>

            <div class="widget topology-widget">
                <div class="widget-title" style="position: absolute; top: 20px; left: 24px;">Runtime Topology Map</div>
                <div class="vis-container">
                    <svg class="connections">
                        <line x1="50%" y1="50%" x2="22.5%" y2="22.5%" class="connection-line" />
                        <line x1="50%" y1="50%" x2="77.5%" y2="22.5%" class="connection-line" />
                        <line x1="50%" y1="50%" x2="32.5%" y2="77.5%" class="connection-line" />
                        <line x1="50%" y1="50%" x2="82.5%" y2="67.5%" class="connection-line" />
                    </svg>

                    <div class="node-core">CORE</div>
                    
                    <div class="node-module nm-1" title="Auth Provider">
                        <span class="material-symbols-rounded">lock</span>
                    </div>
                    <div class="node-module nm-2" title="Payment Gateway">
                        <span class="material-symbols-rounded">payments</span>
                    </div>
                    <div class="node-module nm-3" title="Notification Service">
                        <span class="material-symbols-rounded">notifications</span>
                    </div>
                    <div class="node-module nm-4" title="Analytics">
                        <span class="material-symbols-rounded">bar_chart</span>
                    </div>
                </div>
            </div>

            <div class="widget modules-list-widget">
                <div class="widget-title">
                    Gerenciamento
                    <span style="font-size: 0.7rem; color: var(--primary-color); cursor: pointer;">Ver todos</span>
                </div>
                
                {{#each modules}}
                <div class="module-item">
                    <div class="mi-info">
                        <h4>{{this.name}}</h4>
                        <p>v{{this.version}} • {{this.ram}}</p>
                    </div>
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <span style="font-size: 0.75rem; color: var(--text-secondary);">{{this.uptime}}</span>
                        {{#if (eq this.status 'active')}}
                            <div class="mi-status st-active" title="Running"></div>
                        {{/if}}
                        {{#if (eq this.status 'warning')}}
                            <div class="mi-status st-warning" title="Degraded"></div>
                        {{/if}}
                         {{#if (eq this.status 'inactive')}}
                            <div class="mi-status st-inactive" title="Stopped"></div>
                        {{/if}}
                    </div>
                </div>
                {{/each}}
            </div>

            <div class="widget terminal-widget">
                <div class="term-header">
                    <span style="color: var(--text-secondary); font-size: 0.8rem;">deployer-cli --watch</span>
                    <div style="display: flex; gap: 6px;">
                        <div style="width: 10px; height: 10px; border-radius: 50%; background: #333;"></div>
                        <div style="width: 10px; height: 10px; border-radius: 50%; background: #333;"></div>
                    </div>
                </div>
                <div class="term-body" id="terminal-body">
                    <div class="log-entry">
                        <span class="log-ts">[10:42:01]</span>
                        <span class="log-info">INFO</span>
                        <span class="log-msg">Core system heartbeat initialized.</span>
                    </div>
                    <div class="log-entry">
                        <span class="log-ts">[10:42:05]</span>
                        <span class="log-info">INFO</span>
                        <span class="log-msg">Module 'payment-gateway-stripe' attached successfully in 24ms.</span>
                    </div>
                    <div class="log-entry">
                        <span class="log-ts">[10:42:12]</span>
                        <span class="log-warn">WARN</span>
                        <span class="log-msg">Module 'notification-service' high latency detected (150ms).</span>
                    </div>
                    <div class="log-entry">
                        <span class="log-ts">[10:43:00]</span>
                        <span class="log-info">INFO</span>
                        <span class="log-msg">Garbage collection completed. Freed 12MB.</span>
                    </div>
                    <div class="log-entry">
                        <span class="log-ts">[10:43:15]</span>
                        <span class="log-info">INFO</span>
                        <span class="log-msg">Incoming connection accepted from 192.168.0.1</span>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <script>
        // Simulação de auto-scroll no terminal
        const termBody = document.getElementById('terminal-body');
        termBody.scrollTop = termBody.scrollHeight;
    </script>
</body>
</html>