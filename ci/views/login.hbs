<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | Deployer Platform</title>
    <style>
        /* --- REUTILIZANDO VARIÁVEIS DA HOMEPAGE --- */
        :root {
            --bg-color: #0f172a;       /* Slate 900 */
            --surface-color: #1e293b;  /* Slate 800 */
            --primary-color: #38bdf8;  /* Sky 400 */
            --accent-color: #22d3ee;   /* Cyan 400 */
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --input-bg: #020617;       /* Slate 950 */
            --border-color: rgba(255,255,255,0.1);
            --font-main: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background-color: var(--bg-color);
            color: var(--text-primary);
            font-family: var(--font-main);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            /* Background grid sutil para dar ar técnico */
            background-image: radial-gradient(rgba(56, 189, 248, 0.1) 1px, transparent 1px);
            background-size: 30px 30px;
        }

        /* Container de Login */
        .login-wrapper {
            width: 100%;
            max-width: 420px;
            padding: 20px;
            position: relative;
            z-index: 10;
        }

        /* Card estilo Vidro */
        .login-card {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 40px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            animation: fadeIn 0.6s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Header do Card */
        .card-header { text-align: center; margin-bottom: 32px; }
        .logo { 
            font-size: 1.8rem; 
            font-weight: 700; 
            margin-bottom: 8px; 
            letter-spacing: -1px; 
        }
        .logo span { color: var(--primary-color); }
        .subtitle { color: var(--text-secondary); font-size: 0.9rem; }

        /* Formulário */
        .form-group { margin-bottom: 20px; }
        .form-label {
            display: block;
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin-bottom: 8px;
            font-weight: 500;
        }

        .form-input {
            width: 100%;
            padding: 12px 16px;
            background: var(--input-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            color: var(--text-primary);
            font-size: 1rem;
            transition: all 0.2s;
            outline: none;
        }

        .form-input:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
        }

        /* Botão */
        .btn-primary {
            width: 100%;
            padding: 14px;
            background: linear-gradient(90deg, var(--primary-color), var(--accent-color));
            color: #0f172a;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: opacity 0.2s, transform 0.1s;
            margin-top: 10px;
        }
        .btn-primary:hover { opacity: 0.9; }
        .btn-primary:active { transform: scale(0.98); }

        /* Links auxiliares */
        .auth-links {
            display: flex;
            justify-content: space-between;
            margin-top: 24px;
            font-size: 0.85rem;
        }
        .auth-links a {
            color: var(--text-secondary);
            text-decoration: none;
            transition: color 0.2s;
        }
        .auth-links a:hover { color: var(--primary-color); }

        /* Decorative "Orb" atrás do card */
        .glow-orb {
            position: absolute;
            width: 300px;
            height: 300px;
            background: var(--primary-color);
            filter: blur(80px);
            opacity: 0.15;
            border-radius: 50%;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: -1;
        }

        /* Feedback visual simples para inputs */
        .input-group { position: relative; }
        .icon {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-secondary);
            font-size: 1.2rem;
            pointer-events: none;
        }
    </style>
</head>
<body>

    <div class="login-wrapper">
        <div class="glow-orb"></div>

        <div class="login-card">
            <div class="card-header">
                <div class="logo">apps<span>.deployer</span></div>
                <p class="subtitle">{{ title }}</p>
            </div>

            <form action="/auth/login" method="POST">
                <div class="form-group">
                    <label class="form-label" for="email">E-mail Corporativo</label>
                    <div class="input-group">
                        <input type="email" id="email" name="email" class="form-input" placeholder="dev@apps.ci.dev.br" required autofocus>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="password">Chave de Acesso / Senha</label>
                    <div class="input-group">
                        <input type="password" id="password" name="password" class="form-input" placeholder="••••••••" required>
                    </div>
                </div>

                <button type="submit" class="btn-primary">Acessar Console</button>
            </form>

            <div class="auth-links">
                <a href="#">Esqueceu a senha?</a>
                <a href="#">Solicitar convite</a>
            </div>
        </div>

        <div style="text-align: center; margin-top: 20px; font-size: 0.8rem; color: var(--text-secondary); opacity: 0.6;">
            &copy; {{ year }} Apps Platform. Runtime Security Active.
        </div>
    </div>

</body>
</html>