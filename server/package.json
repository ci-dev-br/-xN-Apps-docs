  "scripts": {
    "build": "node node_modules/@nestjs/cli/bin/nest  build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "set NODE_OPTIONS=--openssl-legacy-provider && node node_modules/@nestjs/cli/bin/nest start --watch",
    "start:debug": "set NODE_OPTIONS=--openssl-legacy-provider && node --max-old-space-size=4098 node_modules/@nestjs/cli/bin/nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.0",
    "@nestjs/cache-manager": "^12.0.1",
    "@nestjs/common": "^10.4.0",
