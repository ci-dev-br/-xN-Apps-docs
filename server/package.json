  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@ci/seo-marketing(|/.*)$": "<rootDir>/libs/seo-marketing/src/$1",
      "^@ci/core(|/.*)$": "<rootDir>/libs/core/src/$1",
      "^@ci/manager(|/.*)$": "<rootDir>/libs/manager/src/$1",
      "^@ci/tenant(|/.*)$": "<rootDir>/libs/tenant/src/$1",
