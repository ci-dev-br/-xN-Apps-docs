<service>
	<id>brdevcideployer.exe</id>
	<name>br.dev.ci.deployer</name>
	<description>Micro Application Deloyer.</description>
	<executable>C:\Program Files\nodejs\node.exe</executable>
	<argument>--harmony</argument>
	<argument>C:\projetos\br.dev.ci.apps\node_modules\node-windows\lib\wrapper.js</argument>
	<argument>--file</argument>
	<argument>C:\projetos\br.dev.ci.apps\deployer\main.js</argument>
	<argument>--scriptoptions=</argument>
	<argument>--log</argument>
	<argument>br.dev.ci.deployer wrapper</argument>
	<argument>--grow</argument>
	<argument>0.25</argument>
	<argument>--wait</argument>
	<argument>1</argument>
	<argument>--maxrestarts</argument>
	<argument>3</argument>
	<argument>--abortonerror</argument>
	<argument>n</argument>
	<argument>--stopparentfirst</argument>
	<argument>undefined</argument>
	<logmode>rotate</logmode>
	<stoptimeout>30sec</stoptimeout>
	<serviceaccount>
		<domain>SRV33</domain>
		<user>LocalSystem</user>
		<password></password>
	</serviceaccount>
	<workingdirectory>C:\projetos\br.dev.ci.apps</workingdirectory>
</service>